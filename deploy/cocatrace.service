[Unit]
Description=CocaTrace - API Flask (gunicorn) para mediciones del ESP32
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
User=iot
Group=iot
WorkingDirectory=/home/iot/cocatrace-flask
# 1 proceso con varios hilos: el Lock de app.py protege el CSV solo dentro de un proceso
ExecStart=/home/iot/cocatrace-flask/venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 --access-logfile - app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
